{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": { "sharePointSiteUrl": { "type": "String", "defaultValue": "https://<YOUR-TENANT>.sharepoint.com/sites/FieldInspectionDemo" }, "teamsChannelId": { "type": "String", "defaultValue": "<TEAMS-CHANNEL-ID>" }, "onCallEmail": { "type": "String", "defaultValue": "oncall@<YOUR-TENANT>.onmicrosoft.com" } },
  "triggers": { "When_an_item_is_created_or_modified": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_sharepointonline", "operationId": "GetOnUpdatedItems", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" }, "parameters": { "dataset": "@parameters('sharePointSiteUrl')", "table": "FieldIssues" } } } },
  "actions": { "If_critical_open": { "type": "If", "expression": { "and": [ { "equals": ["@triggerBody()?['Severity']", "Critical"] }, { "not": { "equals": ["@triggerBody()?['Status']", "Resolved"] } }, { "not": { "equals": ["@triggerBody()?['Status']", "Rejected"] } } ] }, "actions": { "Post_to_Teams_channel": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_teams", "operationId": "PostMessageToConversation", "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams" }, "parameters": { "poster": "Flow bot", "location": "Channel", "body/recipient": "@parameters('teamsChannelId')", "body/messageBody": "@concat('CRITICAL field issue: ', triggerBody()?['IssueID'], ' ', triggerBody()?['AIAnalysis'], ' Map: https://www.google.com/maps?q=', triggerBody()?['Latitude'], ',', triggerBody()?['Longitude'])" } } }, "Send_on_call_email": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_office365", "operationId": "SendEmailV2", "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365" }, "parameters": { "emailMessage/To": "@parameters('onCallEmail')", "emailMessage/Subject": "Critical field issue escalation", "emailMessage/Body": "@concat(triggerBody()?['IssueID'], ' requires immediate attention. ', triggerBody()?['RecommendedAction'])" } } } }, "else": { "actions": {} } } },
  "outputs": {}
}
