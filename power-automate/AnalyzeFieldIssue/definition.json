{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "sharePointSiteUrl": { "type": "String", "defaultValue": "https://<YOUR-TENANT>.sharepoint.com/sites/FieldInspectionDemo" }
  },
  "triggers": {
    "When_an_item_is_created": {
      "type": "OpenApiConnection",
      "inputs": { "host": { "connectionName": "shared_sharepointonline", "operationId": "GetOnNewItems", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" }, "parameters": { "dataset": "@parameters('sharePointSiteUrl')", "table": "FieldIssues" } }
    }
  },
  "actions": {
    "Get_photo_attachments": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_sharepointonline", "operationId": "GetItemAttachments", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" }, "parameters": { "dataset": "@parameters('sharePointSiteUrl')", "table": "FieldIssues", "itemId": "@triggerBody()?['ID']" } } },
    "Call_AI_vision": { "type": "OpenApiConnection", "runAfter": { "Get_photo_attachments": ["Succeeded"] }, "inputs": { "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "CreateTextWithGPTUsingAPrompt", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" }, "parameters": { "promptName": "Analyze Field Issue Photo", "text": "@triggerBody()?['Description']", "image": "@first(body('Get_photo_attachments'))" } } },
    "Parse_AI_JSON": { "type": "ParseJson", "runAfter": { "Call_AI_vision": ["Succeeded"] }, "inputs": { "content": "@body('Call_AI_vision')", "schema": { "type": "object", "required": ["issueType", "detectedConditions", "severity", "recommendedPriority", "recommendedAction", "confidence", "publicSafetyRisk", "estimatedCost", "reasoning"], "properties": { "issueType": { "type": "string" }, "detectedConditions": { "type": "array", "items": { "type": "string" } }, "severity": { "type": "string" }, "recommendedPriority": { "type": "string" }, "recommendedAction": { "type": "string" }, "confidence": { "type": "number" }, "publicSafetyRisk": { "type": "boolean" }, "estimatedCost": { "type": "number" }, "reasoning": { "type": "string" } } } } },
    "List_recent_FieldIssues": { "type": "OpenApiConnection", "runAfter": { "Parse_AI_JSON": ["Succeeded"] }, "inputs": { "host": { "connectionName": "shared_sharepointonline", "operationId": "GetItems", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" }, "parameters": { "dataset": "@parameters('sharePointSiteUrl')", "table": "FieldIssues", "$filter": "ID ne @{triggerBody()?['ID']}" } } },
    "Find_duplicate_or_recurring": { "type": "Query", "runAfter": { "List_recent_FieldIssues": ["Succeeded"] }, "inputs": { "from": "@body('List_recent_FieldIssues')?['value']", "where": "@or(equals(item()?['AssetID'], triggerBody()?['AssetID']), and(lessOrEquals(abs(sub(float(item()?['Latitude']), float(triggerBody()?['Latitude']))), 0.0009), lessOrEquals(abs(sub(float(item()?['Longitude']), float(triggerBody()?['Longitude']))), 0.0009)))" } },
    "Update_FieldIssues": { "type": "OpenApiConnection", "runAfter": { "Find_duplicate_or_recurring": ["Succeeded"] }, "inputs": { "host": { "connectionName": "shared_sharepointonline", "operationId": "PatchItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" }, "parameters": { "dataset": "@parameters('sharePointSiteUrl')", "table": "FieldIssues", "id": "@triggerBody()?['ID']", "item/IssueType": "@body('Parse_AI_JSON')?['issueType']", "item/Severity": "@body('Parse_AI_JSON')?['severity']", "item/RecommendedPriority": "@body('Parse_AI_JSON')?['recommendedPriority']", "item/RecommendedAction": "@body('Parse_AI_JSON')?['recommendedAction']", "item/AIAnalysis": "@body('Parse_AI_JSON')?['reasoning']", "item/AIDetectedConditions": "@join(body('Parse_AI_JSON')?['detectedConditions'], '; ')", "item/AIConfidence": "@body('Parse_AI_JSON')?['confidence']", "item/EstimatedCost": "@body('Parse_AI_JSON')?['estimatedCost']", "item/Status": "AI Analyzed", "item/DuplicateOf": "@if(greater(length(body('Find_duplicate_or_recurring')), 0), first(body('Find_duplicate_or_recurring'))?['ID'], null)" } } },
    "Write_audit_log": { "type": "OpenApiConnection", "runAfter": { "Update_FieldIssues": ["Succeeded"] }, "inputs": { "host": { "connectionName": "shared_sharepointonline", "operationId": "PostItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" }, "parameters": { "dataset": "@parameters('sharePointSiteUrl')", "table": "IssueAuditLog", "item/Title": "AI analysis completed", "item/IssueID": "@triggerBody()?['ID']", "item/Action": "AnalyzeFieldIssue", "item/Timestamp": "@utcNow()", "item/Details": "@string(body('Parse_AI_JSON'))" } } }
  },
  "outputs": {}
}
