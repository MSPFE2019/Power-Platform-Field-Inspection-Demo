{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": { "sharePointSiteUrl": { "type": "String", "defaultValue": "https://<YOUR-TENANT>.sharepoint.com/sites/FieldInspectionDemo" } },
  "triggers": { "When_an_item_is_modified": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_sharepointonline", "operationId": "GetOnUpdatedItems", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" }, "parameters": { "dataset": "@parameters('sharePointSiteUrl')", "table": "FieldIssues" } } } },
  "actions": {
    "Only_AI_Analyzed": { "type": "If", "expression": { "equals": ["@triggerBody()?['Status']", "AI Analyzed"] }, "actions": {
      "Set_pending_approval": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_sharepointonline", "operationId": "PatchItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" }, "parameters": { "dataset": "@parameters('sharePointSiteUrl')", "table": "FieldIssues", "id": "@triggerBody()?['ID']", "item/Status": "Pending Approval" } } },
      "Start_Teams_actionable_approval": { "type": "OpenApiConnectionWebhook", "runAfter": { "Set_pending_approval": ["Succeeded"] }, "inputs": { "host": { "connectionName": "shared_approvals", "operationId": "StartAndWaitForAnApproval", "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals" }, "parameters": { "approvalType": "ApproveReject", "title": "@concat('Approve field issue ', triggerBody()?['IssueID'])", "assignedTo": "agency.manager@<YOUR-TENANT>.onmicrosoft.com", "details": "@concat(triggerBody()?['AIAnalysis'], '\nMap: https://www.google.com/maps?q=', triggerBody()?['Latitude'], ',', triggerBody()?['Longitude'], '\nSeverity: ', triggerBody()?['Severity'], '\nAction: ', triggerBody()?['RecommendedAction'], '\nEstimated cost: ', triggerBody()?['EstimatedCost'])", "itemLink": "@triggerBody()?['{Link}']" } } },
      "Apply_approval_outcome": { "type": "If", "runAfter": { "Start_Teams_actionable_approval": ["Succeeded"] }, "expression": { "equals": ["@body('Start_Teams_actionable_approval')?['outcome']", "Approve"] }, "actions": { "Approve_item": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_sharepointonline", "operationId": "PatchItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" }, "parameters": { "dataset": "@parameters('sharePointSiteUrl')", "table": "FieldIssues", "id": "@triggerBody()?['ID']", "item/Status": "Approved", "item/ApprovalDate": "@utcNow()" } } }, "Notify_reporter": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_office365", "operationId": "SendEmailV2", "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365" }, "parameters": { "emailMessage/To": "@triggerBody()?['ReportedBy']?['Email']", "emailMessage/Subject": "Field issue approved", "emailMessage/Body": "Your field issue has been approved and assigned." } } } }, "else": { "actions": { "Reject_item": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_sharepointonline", "operationId": "PatchItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" }, "parameters": { "dataset": "@parameters('sharePointSiteUrl')", "table": "FieldIssues", "id": "@triggerBody()?['ID']", "item/Status": "Rejected", "item/ResolutionNotes": "@body('Start_Teams_actionable_approval')?['comments']" } } } } } }
    }, "else": { "actions": {} } }
  },
  "outputs": {}
}
