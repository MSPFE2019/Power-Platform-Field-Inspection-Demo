{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": { "sharePointSiteUrl": { "type": "String", "defaultValue": "https://<YOUR-TENANT>.sharepoint.com/sites/FieldInspectionDemo" } },
  "triggers": { "PowerApps_or_Copilot": { "type": "Request", "kind": "PowerAppV2", "inputs": { "schema": { "type": "object", "properties": { "queryType": { "type": "string" }, "county": { "type": "string" }, "city": { "type": "string" }, "agency": { "type": "string" }, "issueId": { "type": "string" }, "assetType": { "type": "string" } } } } } },
  "actions": { "Get_FieldIssues": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_sharepointonline", "operationId": "GetItems", "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline" }, "parameters": { "dataset": "@parameters('sharePointSiteUrl')", "table": "FieldIssues" } } }, "Compose_filter_logic": { "type": "Compose", "runAfter": { "Get_FieldIssues": ["Succeeded"] }, "inputs": { "criticalInPortland": "City eq 'Portland' and Severity eq 'Critical' and Status not in Resolved/Rejected", "recurringLocations": "Trailing 12 months grouped by LocationAddress or rounded coordinates, count >= 3", "signsMoreThanTwiceThisYear": "IssueType eq 'Road Sign', current year, grouped by AssetID count > 2", "statusLookup": "IssueID exact match", "averageResolutionTime": "Resolved items only, DateDiff(ReportedDate, ResolvedDate), grouped by County or Agency" } }, "Return_response": { "type": "Response", "kind": "PowerApp", "runAfter": { "Compose_filter_logic": ["Succeeded"] }, "inputs": { "statusCode": 200, "body": { "queryType": "@triggerBody()?['queryType']", "filterLogic": "@outputs('Compose_filter_logic')", "items": "@body('Get_FieldIssues')?['value']" } } } },
  "outputs": {}
}
